{
  "name": "world-agent-design-system",
  "version": "2.2.0",
  "private": true,
  "type": "module",
  "description": "World Agent product demo, experiment workspace, Eve chat feature intent, and live token-driven design system.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/dev.mjs --dist",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "python tests/run_all_browsers.py",
    "test:product-demo": "node --test tests/product-demo.test.mjs && python tests/product_demo_browser.py",
    "check": "npm test && npm run build",
    "test:ui": "node --test tests/ui-state.test.mjs && npm run build && python tests/ui_browser.py",
    "audit:ui": "npm run test:ui && node scripts/check-ui-audit.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
